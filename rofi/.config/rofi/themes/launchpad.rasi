/**********************************************************************
 * Fern's Dotfiles -- Rofi Theme - Dashboard
 * https://github.com/fernzi/dotfiles
 *********************************************************************/

@import "icons/material"

configuration {
	drun-display-format: "{name}";
}

* {
	font-icon: "Material Design Icons, 16";

	background-color: transparent;
	cursor: inherit;
	font: inherit;
	margin: 0;
	padding: 0;
	spacing: 0;
	text-color: inherit;
}

window {
	anchor: center;
	location: center;
	fullscreen: true;

	background-color: black / 90%;
	text-color: #FAFAFA;
	transparency: "real";
}

mainbox {
	children: ["headerbox", "message", "listview"];
	padding: 10% 20%;
	spacing: 4em;
}

/** Search Bar *******************************************************/

headerbox {
	children: ["inputbar", "mode-switcher"];
	expand: false;
	margin: 0 15%;
	orientation: horizontal;
	spacing: 0.6em;
	vertical-align: 0.5;
}

inputbar {
	background-color: white / 10%;
	border-color: white / 40%;
	border-radius: 0.4em;
	border: 1px solid;
	expand: true;
	padding: 0.65em 0.6em;
}

prompt {
	font: @font-icon;
	margin: -1em 0.6em -1em 0;
	text-color: white / 40%;
	vertical-align: 0.5;
}

entry {
	cursor: text;
	placeholder-color: white / 20%;
	placeholder: "Search…";
	vertical-align: 0.5;
}

/** Mode Swicher *****************************************************/

mode-switcher {
	font: @font-icon;
	text-color: white / 40%;
	spacing: 0.6em;
}

button {
	border: 1px solid;
	border-color: white / 40%;
	border-radius: 0.4em;
	padding: 0 0.6em;
}

button.selected {
	background-color: white / 10%;
	text-color: white / 80%;
}

/** Option List ******************************************************/

listview {
	lines: 4;
	columns: 6;
	flow: horizontal;
	spacing: 2em;
}

scrollbar {
	border: 1px solid;
	border-color: white / 20%;
	border-radius: 50%;
	handle-width: 1em;
	handle-color: white / 10%;
	padding: 0.4em;
}

scrollbar handle {
	border-radius: 50%;
}

/** Option Entry *****************************************************/

element {
	border-radius: 1em;
	orientation: vertical;
	cursor: pointer;
	padding: 1em;
	spacing: 1em;
}

element active, element selected.active {
	border: 1px solid;
	border-color: white / 40%;
}

element selected {
	background-color: white / 10%;
}

element-icon {
	size: 4em;
}

element-text {
	horizontal-align: 0.5;
}

/** Message Boxes ****************************************************/

error-message {
	margin: 20%;
	padding: 1em;
	background-color: white / 10%;
	border-radius: 1em;
}
