#######################################################################
# Fern's Dotfiles -- Git Version Control
# https://codeberg.org/fernzi/home
#######################################################################

[core]
	autocrlf = input

[init]
	defaultBranch = master

[alias]
	br = branch
	cl = clone
	cm = commit
	co = checkout
	curr = show --stat HEAD
	df = diff
	dfh = diff @~ @
	dfs = diff --staged
	killit = reset --hard
	ls-untracked = ls-files --exclude-standard --others
	st = status -s
	us = restore --staged

[url "ssh://git@github.com/"]
	pushInsteadOf = https://github.com/

[url "ssh://git@gitlab.com/"]
	pushInsteadOf = https://gitlab.com/

[url "ssh://git@codeberg.org/"]
	pushInsteadOf = https://codeberg.org/

[include]
	path = local
